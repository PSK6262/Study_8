<?xml version="1.0" encoding="UTF-8"?> 
<!DOCTYPE mapper PUBLIC
		   "-//mybatis.org//DTD Mapper 3.0//EN" 
		   "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
		   
<mapper namespace="file_mapper">
	<insert id="saveFileInfo" parameterType="FileInfo">
		insert into file_Info (file_name , original_file_name , file_path , url_file_path)
		values (
			#{fileName},
			#{originalFileName},
			#{filePath},
			#{urlFilePath}
		)
	</insert>
	<select id="findFileInfoByFileName" parameterType="String" resultType="FileInfo">
		select *
		from file_info
		where file_name = #{fileName}
	</select>
</mapper>